generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model AuditLog {
  id        String   @id @default(uuid())
  articleId String
  partnerCode      String
  timestamp DateTime @default(now())
  log   Json
  statusCode Int
  status ArticleStatus @default(PENDING)
}

enum ArticleStatus {
  PUBLISHED
  REJECTED
  PENDING  
}


model Partner{
  id        String   @id @default(uuid())
  name      String
  code      String
  description String
  config      Json
  validationConfig Json
  isActive          Boolean @default(true)
  createAt DateTime @default(now())
}



